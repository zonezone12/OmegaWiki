<simulation verbosity='medium'>
  <!-- 300 ps at 0.5 fs/step = 600000 steps -->
  <total_steps>600000</total_steps>

  <output prefix='ipi_opes'>
    <properties stride='10' filename='md'>
      [ step, time{picosecond}, potential{electronvolt}, temperature{kelvin} ]
    </properties>
    <trajectory stride='100' filename='pos' format='xyz' cell_units='angstrom' bead='0'>
      positions{angstrom}
    </trajectory>
  </output>

  <system>
    <initialize nbeads='32'>
      <file mode='xyz' units='angstrom'>init_fad.xyz</file>
      <velocities mode='thermal' units='kelvin'>200</velocities>
    </initialize>

    <forces>
      <force name='physnet-ff' forcefield='physnet-ff'></force>
      <force name='plumed-bias' forcefield='plumed-bias'></force>
    </forces>

    <motion mode='dynamics'>
      <dynamics mode='nvt'>
        <timestep units='femtosecond'>0.5</timestep>
        <thermostat mode='pile_l'>
          <tau units='femtosecond'>500</tau>
        </thermostat>
      </dynamics>
    </motion>

    <ensemble>
      <temperature units='kelvin'>200</temperature>
    </ensemble>

    <cell units='angstrom'>[30.0, 0.0, 0.0, 0.0, 30.0, 0.0, 0.0, 0.0, 30.0]</cell>
  </system>

  <!-- OPES_METAD uses smotion mode='metad' same as WT-MetaD -->
  <smotion mode='metad'>
    <metad>
      <metaff>[ plumed-bias ]</metaff>
    </metad>
  </smotion>

  <ffsocket mode='unix' name='physnet-ff' pbc='false'>
    <address>physnet</address>
    <slots>32</slots>
    <timeout>3600.0</timeout>
  </ffsocket>

  <!-- OPES PLUMED input -->
  <ffplumed name='plumed-bias' pbc='false'>
    <file mode='xyz' units='angstrom'>init_fad.xyz</file>
    <plumed_dat>plumed_fad_opes.dat</plumed_dat>
  </ffplumed>

</simulation>
